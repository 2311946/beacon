<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy Auto Backup rules for Android 11 and earlier.
     An explicit include switches backup to an allowlist: only file/upload/ is backed up.
     SharedPreferences (including github_backup.xml and its .bak) are not included.
     Do not exclude paths outside that allowlist: FullBackupContent rejects them.
     Android 12+ uses data_extraction_rules.xml instead. -->
<full-backup-content>
  <include
    domain="file"
    path="upload/" />
</full-backup-content>
